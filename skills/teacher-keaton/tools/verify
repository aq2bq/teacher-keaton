#!/usr/bin/env bun

// 不変条件の検証ラッパー。
// .qnt から不変条件(頂層の val <Name>: bool)をすべて抽出して quint verify へ
// 渡し、「定義N件 / 指定N件 / 反証なしN件」を探索深度とともに報告する。
// quint verify は --invariant(s) を渡さないとdeadlockしか検査しないため、
// 手作業の列挙では1件落としても検知できない。このツールが検証対象一覧の
// 正本を持つことで、列挙漏れを構造的に防ぐ。
//
// 深度戦略(段階探索):
// 検証のコストは深度に対して掛け算で爆発しうる(組み合わせ爆発)。
// ちょうどいい深さはモデルごとに違い、やってみるまで分からない。
// そこで浅い深度から順に試し、段ごとに時間上限を設ける:
//   - 反証が出たら即停止して報告する
//   - ある深度で時間切れになったら打ち切り、そこまでの結果を報告する
//   - 全段を通過したら最深の結果を報告する
// どの時点で止まっても「どこまで保証できたか」(採用した探索深度)が記録に残る。
// 浅い深度でも時間切れになるモデルは、対象が拡散している徴候であり、
// スコープの絞り直しか抽象化の提案を利用者へ返す引き金にする。
//
// Apalacheの作業場(_apalache-out/)は、成果物の置き場所である keaton/ の中
// (keaton/ が無いspecでは spec の中)に隔離する。
// 全探索深度で反証がない場合は削除し、反証が見つかったときだけ保持して保存場所を報告する。
//
// 規約: 不変条件は頂層の `val <Name>: bool` として書く。
// 補助の補題は def / pure def で書く(不変条件として検証されない)。
//
//   tools/verify <specパス> [--depths 4,8,12] [--timeout <秒>] [--max-steps <n>] [--verbose]
//
// --max-steps は段階探索をせず単一深度で検証する(従来互換)。
// Quint・Apalacheの詳細出力は常に verify.log へ保存し、--verbose 指定時だけ
// 同じ内容を端末にも表示する。

import {
  closeSync,
  existsSync,
  mkdirSync,
  openSync,
  readdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
  writeSync,
} from "node:fs";
import { join, resolve } from "node:path";
import { artifactRootForSpec } from "./lib/artifacts";
import { resolveSpecPath } from "./lib/quint";

type Options = {
  specPath: string;
  depths: number[];
  timeoutSeconds: number;
  maxSteps?: number;
  verbose: boolean;
};

function usage(): void {
  console.error("使い方: tools/verify [<specパス>] [--depths 4,8,12] [--timeout <秒>] [--max-steps <n>] [--verbose]");
  console.error("specパス省略時は keaton/spec を使います。");
  console.error("--depths: 段階探索の深度列(既定 4,8,12)。--timeout: 1段あたりの秒(既定 60)。");
  console.error("--max-steps: 段階探索をせず単一深度で検証する。");
  console.error("--verbose: verify.log へ保存する詳細出力を端末にも表示する。");
}

function parseArguments(argv: string[]): Options | undefined {
  let index = 0;
  let specArg: string | undefined;
  if (argv.length > 0 && !argv[0].startsWith("--")) {
    specArg = argv[0];
    index = 1;
  }
  const options: Options = {
    specPath: resolveSpecPath(specArg),
    depths: [4, 8, 12],
    timeoutSeconds: 60,
    verbose: false,
  };
  for (; index < argv.length; index += 1) {
    const argument = argv[index];
    const next = argv[index + 1];
    switch (argument) {
      case "--depths": {
        if (next === undefined) return undefined;
        const parsed = next.split(",").map((part) => Number(part));
        if (parsed.some((depth) => !Number.isInteger(depth) || depth <= 0)) return undefined;
        options.depths = parsed;
        index += 1;
        break;
      }
      case "--timeout":
        if (next === undefined) return undefined;
        options.timeoutSeconds = Number(next);
        index += 1;
        break;
      case "--max-steps":
        if (next === undefined) return undefined;
        options.maxSteps = Number(next);
        index += 1;
        break;
      case "--verbose":
        options.verbose = true;
        break;
      default:
        return undefined;
    }
  }
  return options;
}

const options = parseArguments(Bun.argv.slice(2));
if (options === undefined) {
  usage();
  process.exit(1);
}

const resolved = resolve(options.specPath);
const qntFiles = readdirSync(resolved).filter(
  (file) => file.endsWith(".qnt") && file !== "constants.qnt",
);
if (qntFiles.length === 0) {
  console.error(`error: ${resolved} に .qnt ファイルがありません`);
  process.exit(1);
}

// 頂層(モジュール直下、2スペースインデント)の bool val だけを不変条件とみなす。
// run ブロック内のネストした val は対象外。
const INVARIANT_DECL = /^ {2}val (\w+)\s*:\s*bool\b/;

// Apalacheの作業場。Apalacheは cwd に `_apalache-out/` を作るため、
// cwd を「成果物の置き場所である keaton/」(keaton/ が無いspecでは spec 自体)
// にすれば、作業場は約束された領域の中に収まる。
function workspaceFor(specPath: string): string {
  return artifactRootForSpec(specPath) ?? specPath;
}

const workspace = workspaceFor(resolved);
mkdirSync(workspace, { recursive: true });
const logPath = join(workspace, "verify.log");
const logFd = openSync(logPath, "w");
writeSync(logFd, `tools/verify ${new Date().toISOString()}\n`);

type StageResult =
  | { outcome: "pass" }
  | { outcome: "violation" }
  | { outcome: "timeout" }
  | { outcome: "error"; status: number };

// Apalacheは反証トレースを _apalache-out/server/<実行ディレクトリ>/violation*.*
// へ書く。これを数階層だけ再帰的に探す。
function hasViolationTrace(dir: string, depthBudget = 4): boolean {
  if (!existsSync(dir) || depthBudget <= 0) {
    return false;
  }
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (entry.name.includes("violation")) {
      return true;
    }
    if (entry.isDirectory() && hasViolationTrace(join(dir, entry.name), depthBudget - 1)) {
      return true;
    }
  }
  return false;
}

async function captureOutput(
  stream: ReadableStream<Uint8Array>,
  terminal: { write(chunk: Uint8Array): unknown },
): Promise<void> {
  const reader = stream.getReader();
  while (true) {
    const { done, value } = await reader.read();
    if (done) return;
    writeSync(logFd, value);
    if (options.verbose) {
      terminal.write(value);
    }
  }
}

async function runVerify(
  file: string,
  invariants: string[],
  apalacheDir: string,
  depth: number,
): Promise<StageResult> {
  writeSync(logFd, `\n=== ${file} / depth ${depth} ===\n`);
  let child: ReturnType<typeof Bun.spawn>;
  try {
    child = Bun.spawn(
      ["quint", "verify", file, "--invariants", ...invariants, "--max-steps", String(depth)],
      { cwd: workspace, stdout: "pipe", stderr: "pipe" },
    );
  } catch (error) {
    const message = `quint の起動に失敗しました: ${(error as Error).message}`;
    writeSync(logFd, `${message}\n`);
    console.error(`error: ${message}`);
    return { outcome: "error", status: 1 };
  }

  let timedOut = false;
  const timeout = setTimeout(() => {
    timedOut = true;
    child.kill("SIGKILL");
  }, options.timeoutSeconds * 1000);
  const [exitCode] = await Promise.all([
    child.exited,
    captureOutput(child.stdout, process.stdout),
    captureOutput(child.stderr, process.stderr),
  ]);
  clearTimeout(timeout);

  if (timedOut) {
    return { outcome: "timeout" };
  }
  if (exitCode === 0) {
    return { outcome: "pass" };
  }
  // quint verify は反証発見時も非ゼロで終わる。作業場に残った
  // violation のトレースで区別がつく。
  return hasViolationTrace(apalacheDir)
    ? { outcome: "violation" }
    : { outcome: "error", status: exitCode };
}

// 検証結果の機械可読な記録。explain が「形式モデルの検証」節として取り込み、
// オンボーディング文書が単体で完結するようにする。
type FileResult = {
  file: string;
  invariants: string[];
  outcome: "pass" | "violation" | "timeout" | "error";
  depthReached?: number;
};
const fileResults: FileResult[] = [];

let failed = false;
for (const file of qntFiles) {
  const text = readFileSync(join(resolved, file), "utf-8");
  const invariants = text
    .split("\n")
    .map((line) => line.match(INVARIANT_DECL)?.[1])
    .filter((name): name is string => name !== undefined);

  if (invariants.length === 0) {
    console.error(
      `warning: ${file} に不変条件の宣言(頂層の val <Name>: bool)がありません`,
    );
    continue;
  }

  const apalacheDir = join(workspace, "_apalache-out");
  rmSync(apalacheDir, { recursive: true, force: true });
  const depths = options.maxSteps !== undefined ? [options.maxSteps] : options.depths;
  console.log(
    `verifying ${file}: ${invariants.length} invariant(s) — ${invariants.join(", ")}`,
  );
  console.log(
    `  深度戦略: ${depths.join(" → ")} (1段あたり ${options.timeoutSeconds}秒)`,
  );

  let lastPassDepth: number | undefined;
  let stoppedAt: { depth: number; reason: "timeout" | "violation" | "error" } | undefined;
  for (const depth of depths) {
    console.log(`  深度 ${depth} を検証中...`);
    const stage = await runVerify(join(resolved, file), invariants, apalacheDir, depth);
    if (stage.outcome === "pass") {
      lastPassDepth = depth;
      continue;
    }
    stoppedAt = { depth, reason: stage.outcome };
    break;
  }

  if (stoppedAt?.reason === "violation") {
    console.error(
      `error: ${file}: 深度 ${stoppedAt.depth} で不変条件の反証が見つかりました`,
    );
    console.error(`  反証トレースの保存場所: ${apalacheDir}/`);
    fileResults.push({ file, invariants, outcome: "violation", depthReached: stoppedAt.depth });
    failed = true;
  } else if (stoppedAt !== undefined) {
    console.error(
      `error: ${file}: 深度 ${stoppedAt.depth} の検証に失敗しました` +
        (stoppedAt.reason === "timeout"
          ? `(タイムアウト: 1段${options.timeoutSeconds}秒)`
          : ""),
    );
    if (lastPassDepth !== undefined) {
      console.error(
        `  深度 ${lastPassDepth} までは不変条件の反証は見つかっていません。` +
          "浅い深度での時間切れは、対象が拡散している徴候です。" +
          "スコープの絞り直しか、重い表現(文字列のタイムスタンプ等)の抽象化を検討してください。",
      );
    }
    console.error(`  Apalache作業場: ${apalacheDir}/`);
    fileResults.push({ file, invariants, outcome: stoppedAt.reason, depthReached: lastPassDepth });
    failed = true;
  } else {
    rmSync(apalacheDir, { recursive: true, force: true });
    console.log(
      `ok: ${file}: 形式モデルの不変条件 定義${invariants.length}件 / ` +
        `指定${invariants.length}件 / 反証なし${invariants.length}件 ` +
        `(探索深度 ${lastPassDepth})`,
    );
    fileResults.push({ file, invariants, outcome: "pass", depthReached: lastPassDepth });
  }
}

const resultPath = join(workspace, "verify-result.json");
writeFileSync(
  resultPath,
  JSON.stringify({ verifiedAt: new Date().toISOString(), results: fileResults }, null, 2) + "\n",
);
closeSync(logFd);

console.log(`詳細ログ: ${logPath}`);
console.log(`検証結果(JSON): ${resultPath}`);

process.exit(failed ? 1 : 0);
