#!/usr/bin/env bun

import { resolve } from "node:path";
import { writeFileSync } from "node:fs";
import {
  fetchKnownIds,
  generateConstants,
  moduleNameFor,
} from "./lib/quint-constants.ts";
import { resolveSpecPath } from "./lib/quint";

const resolved = resolve(resolveSpecPath(process.argv[2]));
const ids = fetchKnownIds(resolved);
const moduleName = moduleNameFor(resolved);
const content = generateConstants(ids, moduleName);
const target = `${resolved}/constants.qnt`;

writeFileSync(target, content);
console.log(`wrote ${target} (${ids.length} ids)`);
