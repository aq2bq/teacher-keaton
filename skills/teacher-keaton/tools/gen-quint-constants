#!/usr/bin/env bun

import { resolve } from "node:path";
import { writeFileSync } from "node:fs";
import {
  fetchKnownIds,
  generateConstants,
  moduleNameFor,
} from "./lib/quint-constants.ts";

const specPath = process.argv[2];

if (specPath === undefined) {
  console.error("使い方: tools/gen-quint-constants <specパス>");
  console.error("例:   tools/gen-quint-constants apps/momotaro/spec");
  process.exit(1);
}

const resolved = resolve(specPath);
const ids = fetchKnownIds(resolved);
const moduleName = moduleNameFor(resolved);
const content = generateConstants(ids, moduleName);
const target = `${resolved}/constants.qnt`;

writeFileSync(target, content);
console.log(`wrote ${target} (${ids.length} ids)`);
