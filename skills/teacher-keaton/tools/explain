#!/usr/bin/env bun

// 全部入り解説書ツール: 一つのシステムを「用語表・概念マップ・振る舞いの図」として
// 一つのMarkdownにまとめて出力する。学習(オンボーディング)と分析の両方に使う。
//
//   tools/explain <specパス> [--test <テスト名> | --all-tests] [--seed <値>]
//                 [--max-steps <n>] [--output <パス>]
//                 [--focus <用語または概念id>] [--focus-depth <非負整数>]
//
// 各ビューはすべてCUEの語彙とQuintの振る舞いから派生するため、用語と構造の
// 整合性が構造的に保証される。ビューごとに適用可否を検出し、该系统統に合うものだけ出す:
//   - 用語表       : CUEの glossary があれば
//   - 測度表       : CUEの measures があれば
//   - 概念マップ   : CUEの relations があれば
//   - シーケンス図 : projection.cue に message イベントがあれば
//   - 状態遷移図   : projection.cue に transition イベントがあれば
//
// --all-tests は .qnt の `run <名前>Test` をすべて列挙し、シナリオごとの図を
// 一つのMarkdownに束ねる。keaton_YYYYMMDDHHmmss/spec を使う通常経路では、
// keaton_YYYYMMDDHHmmss/explanation.md へ保存する。

import {
  cleanupTrace,
  cueExport,
  findQuintInput,
  generateTrace,
  resolveSpecPath,
  tryCueExport,
} from "./lib/quint";
import {
  artifactRootForSpec,
  isArtifactRootName,
  explanationPathForSpec,
  resolveArtifactOutputPath,
} from "./lib/artifacts";
import { detectEvents, makeProjectionContext, projectionVocabRefs, type ProjectionSpec, type Trace } from "./lib/projection";
import { makeLabelResolver, render } from "./lib/render";
import {
  renderGlossary,
  validateGlossaryProvenance,
  type Glossary,
} from "./lib/glossary";
import { renderMeasures, type Measures } from "./lib/measures";
import { generate as generateConceptMap, type Input as ConceptMapInput } from "./diagram-gen-bun/index";
import { basename, dirname, resolve, join } from "node:path";
import { existsSync, mkdirSync } from "node:fs";

type Options = {
  specPath: string;
  testName?: string;
  allTests: boolean;
  output?: string;
  seed?: string;
  maxSteps: number;
  focus?: string;
  focusDepth?: number;
};

function usage(): void {
  console.error(
    "使い方: tools/explain [<specパス>] " +
      "[--test <テスト名> | --all-tests] [--seed <値>] [--max-steps <n>] " +
      "[--output <パス>] [--focus <用語または概念id>] [--focus-depth <非負整数>]",
  );
  console.error("specパス省略時は spec を持つ最新の keaton_YYYYMMDDHHmmss/ を使います。");
  console.error("keaton_YYYYMMDDHHmmss/spec の解説書は keaton_YYYYMMDDHHmmss/explanation.md へ保存します。");
  console.error("--output の保存先は実行場所の keaton_YYYYMMDDHHmmss/ 配下に限ります。");
  console.error("--focus-depth の既定は1です。--focus が無い場合は指定できません。");
}

function parseArguments(argv: string[]): Options | undefined {
  let index = 0;
  let specArg: string | undefined;
  if (argv.length > 0 && !argv[0].startsWith("--")) {
    specArg = argv[0];
    index = 1;
  }
  const options: Options = { specPath: resolveSpecPath(specArg), allTests: false, maxSteps: 12 };
  for (; index < argv.length; index += 1) {
    const argument = argv[index];
    const next = argv[index + 1];
    switch (argument) {
      case "--test":
        if (next === undefined) return undefined;
        options.testName = next;
        index += 1;
        break;
      case "--all-tests":
        options.allTests = true;
        break;
      case "--output":
        if (next === undefined) return undefined;
        options.output = next;
        index += 1;
        break;
      case "--seed":
        if (next === undefined) return undefined;
        options.seed = next;
        index += 1;
        break;
      case "--max-steps":
        if (next === undefined) return undefined;
        options.maxSteps = Number(next);
        index += 1;
        break;
      case "--focus":
        if (next === undefined || next.startsWith("--")) return undefined;
        options.focus = next;
        index += 1;
        break;
      case "--focus-depth": {
        if (next === undefined) return undefined;
        const depth = Number(next);
        if (!Number.isInteger(depth) || depth < 0) return undefined;
        options.focusDepth = depth;
        index += 1;
        break;
      }
      default:
        return undefined;
    }
  }
  if (options.testName !== undefined && options.allTests) {
    console.error("error: --test と --all-tests は同時に指定できません");
    return undefined;
  }
  if (options.focus === undefined && options.focusDepth !== undefined) {
    console.error("error: --focus-depth には --focus が必要です");
    return undefined;
  }
  if (options.focus !== undefined && options.focusDepth === undefined) {
    options.focusDepth = 1;
  }
  return options;
}

// .qnt からシナリオテスト(名前が Test で終わる run 定義)を列挙する。
// quint test の規約と同じ命名規則を正本にする。
async function listTestNames(specPath: string): Promise<string[]> {
  const quintInput = await findQuintInput(specPath);
  const text = await Bun.file(quintInput).text();
  const names: string[] = [];
  for (const match of text.matchAll(/^\s*run\s+(\w*Test)\s*=/gm)) {
    if (!names.includes(match[1])) {
      names.push(match[1]);
    }
  }
  return names;
}

const options = parseArguments(Bun.argv.slice(2));
if (options === undefined) {
  usage();
  process.exit(1);
}

const resolvedSpecPath = resolve(options.specPath);
let resolvedOutputPath: string | undefined;
try {
  resolvedOutputPath = options.output === undefined
    ? explanationPathForSpec(resolvedSpecPath)
    : resolveArtifactOutputPath(options.output, resolvedSpecPath);
} catch (error) {
  console.error(`error: ${(error as Error).message}`);
  process.exit(1);
}
// 解説書の題名はプロジェクト名から取る。既定の <project>/keaton_YYYYMMDDHHmmss/spec のように
// 直上が時刻付き成果物ルートなら、その一つ上をプロジェクト名とする。
let appName = basename(dirname(resolvedSpecPath));
if (appName === "keaton" || isArtifactRootName(appName)) {
  appName = basename(dirname(dirname(resolvedSpecPath)));
}

// CUEから各ビューの元データを読む。
const glossary = await cueExport<Glossary>(resolvedSpecPath, "glossary");
const provenanceErrors = validateGlossaryProvenance(glossary);
if (provenanceErrors.length > 0) {
  for (const error of provenanceErrors) console.error(`error: ${error}`);
  process.exit(1);
}
const relations = await cueExport<ConceptMapInput["relations"]>(resolvedSpecPath, "relations");
const vocabulary = await cueExport<ConceptMapInput["vocabulary"]>(resolvedSpecPath, "vocabulary");
const projection = await cueExport<ProjectionSpec>(resolvedSpecPath, "projection");
// 測度(任意)。数値尺度を持つシステムだけが宣言する。
const measures = await tryCueExport<Measures>(resolvedSpecPath, "measures");
const projectionContext = makeProjectionContext(measures);

// 解説のメタデータ(任意)。題名・目的・対象範囲・除外範囲を書けば、
// 解説書が単体で完結する。無ければディレクトリ名を題名にする。
type About = {
  title?: string;
  purpose?: string;
  scope?: string;
  exclusions?: string[];
  operationalUndecided?: string[];
};
const about = await tryCueExport<About>(resolvedSpecPath, "about");

// tools/verify が書き出した最新の検証結果(任意)。
type VerifyFileResult = {
  file: string;
  invariants: string[];
  outcome: "pass" | "violation" | "timeout" | "error";
  depthReached?: number;
};
type VerifyResult = { verifiedAt: string; results: VerifyFileResult[] };
function verifyResultPath(specPath: string): string {
  const base = artifactRootForSpec(specPath) ?? specPath;
  return join(base, "verify-result.json");
}
let verifyResult: VerifyResult | undefined;
if (existsSync(verifyResultPath(resolvedSpecPath))) {
  try {
    verifyResult = await Bun.file(verifyResultPath(resolvedSpecPath)).json() as VerifyResult;
  } catch {
    verifyResult = undefined;
  }
}

// 適用できるビューを検出する。
const hasGlossary = Object.keys(glossary).length > 0;
const hasMeasures = measures !== undefined && Object.keys(measures).length > 0;
const hasConceptMap = relations.length > 0 || options.focus !== undefined;
const hasSequence = projection.events.some((event) => event.message !== undefined);
const hasState = projection.events.some((event) => event.transition !== undefined);
const needsTrace = hasSequence || hasState;

const resolveLabel = makeLabelResolver(vocabulary);
const fence = (diagram: string) => "```mermaid\n" + diagram + "```";

const sections: string[] = [`# ${about?.title ?? appName} 解説書`];

if (about !== undefined && (about.purpose !== undefined || about.scope !== undefined || (about.exclusions ?? []).length > 0)) {
  const overview: string[] = ["## 概要"];
  if (about.purpose !== undefined) overview.push(`- 目的: ${about.purpose}`);
  if (about.scope !== undefined) overview.push(`- 対象範囲: ${about.scope}`);
  if ((about.exclusions ?? []).length > 0) {
    overview.push("- 除外範囲:");
    for (const exclusion of about.exclusions ?? []) {
      overview.push(`  - ${exclusion}`);
    }
  }
  sections.push(overview.join("\n"));
}

if ((about?.operationalUndecided ?? []).length > 0) {
  sections.push([
    "## 運用未確定",
    "",
    ...(about?.operationalUndecided ?? []).map((item) => `- ${item}`),
  ].join("\n"));
}

if (verifyResult !== undefined) {
  const lines: string[] = [
    `## 形式モデルの検証 (${verifyResult.verifiedAt})`,
    "",
    "> この結果は、形式モデルに置いた前提に対する、結果に記載された探索深度までの不変条件検査です。" +
      "教育・記録・遵守を含む現場運用の実効性は検証していません。",
    "",
  ];
  for (const result of verifyResult.results) {
    const total = result.invariants.length;
    switch (result.outcome) {
      case "pass":
        lines.push(
          `- ${result.file}: 不変条件 ${total}/${total} 件で反証なし` +
            ` (探索深度 ${result.depthReached ?? "?"})`,
        );
        break;
      case "violation":
        lines.push(`- ${result.file}: 深度 ${result.depthReached ?? "?"} で不変条件の反証が見つかった`);
        break;
      default:
        lines.push(
          `- ${result.file}: 検証未完了 (${result.outcome})` +
            (result.depthReached !== undefined ? ` — 深度 ${result.depthReached} までは反証なし` : ""),
        );
    }
    lines.push(`  - 対象: ${result.invariants.join(", ")}`);
  }
  sections.push(lines.join("\n"));
}

if (hasGlossary) {
  sections.push("## 用語表", renderGlossary(glossary));
}

if (hasMeasures && measures !== undefined) {
  // 測度表: 数値の向き(極性)と閾値の意味を、判定できる形で並べる。
  // 名前の印象で向きを取り違えるのを防ぐ、照合の主要な材料。
  sections.push("## 測度(数値尺度)", renderMeasures(measures));
}

if (hasConceptMap) {
  let conceptMap: string;
  try {
    conceptMap = generateConceptMap({
      vocabulary,
      relations,
      projectionRefs: projectionVocabRefs(projection),
      focus: options.focus === undefined
        ? undefined
        : { concept: options.focus, depth: options.focusDepth ?? 1 },
    });
  } catch (error) {
    console.error(`error: ${(error as Error).message}`);
    process.exit(1);
  }
  sections.push("## 概念マップ", fence(conceptMap));
}

if (needsTrace && options.allTests) {
  // 全シナリオ: テストを列挙し、テストごとの図を一つのMarkdownに束ねる。
  const testNames = await listTestNames(resolvedSpecPath);
  if (testNames.length === 0) {
    console.error("error: Test で終わる run 定義が見つかりません");
    process.exit(1);
  }
  sections.push("## 振る舞い");
  for (const testName of testNames) {
    const generated = await generateTrace(resolvedSpecPath, { mode: "test", testName });
    const trace = await Bun.file(generated.path).json() as Trace;
    const steps = detectEvents(trace, projection, projectionContext);
    const testSections: string[] = [`### ${testName}`];
    if (hasSequence) {
      testSections.push(fence(render("sequenceDiagram", steps, resolveLabel)));
    }
    if (hasState) {
      testSections.push(fence(render("stateDiagram", steps, resolveLabel)));
    }
    sections.push(testSections.join("\n"));
    await cleanupTrace(generated.directory);
  }
} else if (needsTrace) {
  // 単一トレース: 既定はランダム実行(観測)、--test で固定シナリオ(宣言)。
  const source = options.testName === undefined
    ? { mode: "run" as const, seed: options.seed, maxSteps: options.maxSteps }
    : { mode: "test" as const, testName: options.testName };
  const generated = await generateTrace(resolvedSpecPath, source);
  const trace = await Bun.file(generated.path).json() as Trace;
  const steps = detectEvents(trace, projection, projectionContext);

  if (hasSequence) {
    sections.push("## シーケンス図", fence(render("sequenceDiagram", steps, resolveLabel)));
  }
  if (hasState) {
    sections.push("## 状態遷移図", fence(render("stateDiagram", steps, resolveLabel)));
  }

  await cleanupTrace(generated.directory);
}

const document = sections.join("\n") + "\n";
if (resolvedOutputPath !== undefined) {
  mkdirSync(dirname(resolvedOutputPath), { recursive: true });
  await Bun.write(resolvedOutputPath, document);
  console.error(`wrote ${resolvedOutputPath}`);
} else {
  process.stdout.write(document);
}
