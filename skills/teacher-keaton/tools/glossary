#!/usr/bin/env bun

// グロッサリー(用語表)を個別に出力するツール。
// CUEの glossary(用語→{id,種別,定義})を読み、Markdownの表で出す。
//
//   tools/glossary [<specパス>]    (既定: keaton_YYYYMMDDHHmmss/spec)

import { cueExport, resolveSpecPath } from "./lib/quint";
import {
  renderGlossary,
  validateGlossaryProvenance,
  type Glossary,
} from "./lib/glossary";

const specPath = resolveSpecPath(Bun.argv[2]);

const glossary = await cueExport<Glossary>(specPath, "glossary");
const provenanceErrors = validateGlossaryProvenance(glossary);
if (provenanceErrors.length > 0) {
  for (const error of provenanceErrors) console.error(`error: ${error}`);
  process.exit(1);
}
process.stdout.write(renderGlossary(glossary));
