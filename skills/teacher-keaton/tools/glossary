#!/usr/bin/env bun

// グロッサリー(用語表)を個別に出力するツール。
// CUEの glossary(用語→{id,種別,定義})を読み、Markdownの表で出す。
//
//   tools/glossary <specパス>

import { cueExport } from "./lib/quint";
import { renderGlossary, type Glossary } from "./lib/glossary";

const specPath = Bun.argv[2];
if (specPath === undefined) {
  console.error("使い方: tools/glossary <specパス>");
  process.exit(1);
}

const glossary = await cueExport<Glossary>(specPath, "glossary");
process.stdout.write(renderGlossary(glossary));
